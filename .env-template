# Copy to .env and edit.
# ARM_* controls Azure auth.
# TF_VAR_* are exported from .env and are the sole deployment input for Terraform.

###############################################################################
# Azure operator context
###############################################################################
# Keep ARM_* and TF_VAR_azure_* aligned unless you intentionally split auth and target.
ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"
ARM_USE_CLI="true"

# Optional non-interactive Azure auth. Do not commit secrets.
# ARM_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ARM_CLIENT_SECRET=""
# ARM_USE_OIDC="true"
# ARM_USE_MSI="true"

TF_VAR_azure_subscription_id="00000000-0000-0000-0000-000000000000"
TF_VAR_azure_tenant_id="00000000-0000-0000-0000-000000000000"
SSH_PRIVATE_KEY_PATH="${HOME:-/home/${USER:-azureoperator}}/.ssh/id_ed25519"

# Optional: set to a reachable repo URL (for example a public fork) to have the
# jump-host bootstrap git-clone the repo instead of waiting for 'module 2 sync'.
# You still run 'module 2 sync' once to place the gitignored .env on the VM.
# See docs/modules/module-2-jump-hosts.md for the trade-offs.
# ANYSCALE_AKS_REPO_URL="https://github.com/<your-org>/<your-fork>"

###############################################################################
# Deployment naming and tags
###############################################################################
TF_VAR_project="myproject"
TF_VAR_environment="dev"
TF_VAR_azure_location="westus2"
TF_VAR_region_short="wus2"
TF_VAR_global_name_suffix=""
TF_VAR_tags='{"Project":"myproject","Environment":"dev","ManagedBy":"terraform","Owner":"change-me"}'

###############################################################################
# Anyscale CLI and cloud metadata
###############################################################################
# Local interactive login:
#   ANYSCALE_HOST=https://console.azure.anyscale.com .venv/bin/anyscale login
# Leave cloud name and deployment ID blank on the first deploy; the harness backfills them.
# Use ANYSCALE_CLI_TOKEN only for non-interactive or in-pod CLI flows.
ANYSCALE_HOST="https://console.azure.anyscale.com"
ANYSCALE_BROWSER_AUTH_HOST="https://console.anyscale.com"
ANYSCALE_CLOUD_NAME=""
ANYSCALE_CLOUD_DEPLOYMENT_ID=""
ANYSCALE_CLI_TOKEN=""

###############################################################################
# Optional custom image proof
###############################################################################
# Local podman mode builds on the in-VNet Linux jump host, which already reaches
# the private ACR and storage endpoints through private DNS.
# Current harness path: podman. Other values are reserved for future modes.
ANYSCALE_CUSTOM_IMAGE_ENABLED="false"
ANYSCALE_CUSTOM_IMAGE_REPOSITORY="anyscale/proof-custom"
ANYSCALE_CUSTOM_IMAGE_TAG="onnxruntime-1.22.0-ray-2.55.1-py312-cu129"
ANYSCALE_CUSTOM_IMAGE_RAY_VERSION="2.55.1"
ANYSCALE_CUSTOM_IMAGE_REQUIREMENT="onnxruntime==1.22.0"
ANYSCALE_CUSTOM_IMAGE_BUILD_MODE="podman"
ANYSCALE_CUSTOM_IMAGE_BASE_IMAGE="docker.io/anyscale/ray:2.55.1-slim-py312-cu129"
ANYSCALE_CUSTOM_IMAGE_URI=""

###############################################################################
# Network layout
###############################################################################
TF_VAR_vnet_address_space='["10.50.0.0/16"]'
TF_VAR_subnet_cidrs='{"firewall":"10.50.0.0/26","bastion":"10.50.0.128/26","aks_apiserver":"10.50.1.0/28","dns_resolver_in":"10.50.1.16/28","dns_resolver_out":"10.50.1.32/28","private_endpoints":"10.50.2.0/24","jump_host":"10.50.3.0/27","browser_jump_host":"10.50.3.32/27","aks_nodes":"10.50.4.0/22"}'
TF_VAR_service_cidr="10.100.0.0/16"
TF_VAR_dns_service_ip="10.100.0.10"

###############################################################################
# Foundation jump hosts
###############################################################################
TF_VAR_linux_jump_host_vm_size="Standard_D4s_v5"
TF_VAR_linux_jump_host_admin_username="azureoperator"
# Required public key for the Linux jump host. Keep the full OpenSSH public-key line in .env.
TF_VAR_linux_jump_host_admin_ssh_public_key=""
# Optional base64-encoded cloud-init payload for the Linux jump host. Empty = none.
TF_VAR_linux_jump_host_custom_data=""
# Grant the Terraform-executing principal AKS admin/user. Set false in jump-host
# mode and supply explicit principal maps below.
TF_VAR_assign_current_principal_cluster_access="true"
TF_VAR_aks_cluster_admin_principal_ids='{}'
TF_VAR_aks_cluster_user_principal_ids='{}'
TF_VAR_enable_browser_host="false"
TF_VAR_windows_browser_jump_host_vm_size="Standard_D4s_v5"
TF_VAR_windows_browser_jump_host_admin_username="azureadmin"
# Local admin password required by Azure only when the browser host is enabled.
# Leave empty to use the Key Vault-generated password fallback. Never commit a value.
TF_VAR_windows_browser_jump_host_admin_password=""
TF_VAR_browser_host_vm_user_login_principal_ids='{}'
TF_VAR_browser_host_vm_admin_login_principal_ids='{}'
TF_VAR_browser_host_admin_password_secret_name="browser-vm-admin-password"
# Entra principal IDs granted Key Vault Reader and Key Vault Secrets User at the
# vault scope so the Azure portal picker can list and read the browser-host
# password secret. Example: '{"operator":"<object-id>"}'.
TF_VAR_browser_host_admin_password_secret_reader_principal_ids='{}'
# Key Vault public access. Keep false for private-endpoint-only mode. Set true
# only to let the Azure portal "Password from Azure Key Vault" picker reach the
# vault from your workstation; the vault firewall still denies everything except
# AzureServices and the IPv4 CIDRs below.
TF_VAR_key_vault_public_network_access_enabled="false"
# Comma-separated IPv4 CIDRs. Example: "203.0.113.10/32,198.51.100.0/24".
TF_VAR_key_vault_public_access_cidrs_csv=""
TF_VAR_assign_jump_host_subscription_contributor="true"
TF_VAR_jump_host_rbac_scope=""

# Optional conditional forwarders for Azure DNS Private Resolver.
# Example:
# TF_VAR_dns_forwarding_rules='{"corp-contoso":{"domain_name":"corp.contoso.com.","target_dns_servers":[{"ip_address":"10.10.10.10","port":53}]}}'
TF_VAR_dns_forwarding_rules='{}'

###############################################################################
# Firewall allow-lists
###############################################################################
# Keep these at the repo defaults unless your networking review says otherwise.
TF_VAR_anyscale_fqdns='["console.anyscale.com","console.azure.anyscale.com","api.azure.anyscale.com","*.anyscale-cloud.dev","*.azure.anyscale-cloud.dev","*.az1.westus2.admin.azure.anyscale.com","anyscaleazwestus2prod.blob.core.windows.net","anyscaleazwestus2prod.dfs.core.windows.net","api.anyscale.com","anyscale-public.s3.us-west-2.amazonaws.com","anyscale.com","learn.microsoft.com"]'

# Optional separate Anyscale allow-list for the Linux jump-host subnet only.
# Leave empty ('[]') to fall back to TF_VAR_anyscale_fqdns (default behavior).
# Use it to give the Anyscale CLI on the jump host the public console, API, and
# browser-auth hosts it needs for login/job-submit/workspace registration while
# keeping the AKS node list narrower. Pairs with Private Link (below): when
# enable_privatelink drops the private-zone FQDNs from both lists, the jump host
# still keeps its public CLI destinations here.
TF_VAR_anyscale_jump_host_fqdns='[]'

TF_VAR_azure_identity_fqdns='["login.microsoftonline.com","*.login.microsoftonline.com","sts.windows.net","management.azure.com"]'
# Optional: Azure Portal authentication and framework FQDNs allowed only from
# the Windows browser jump-host subnet.
TF_VAR_azure_portal_fqdns='["login.microsoft.com","login.microsoftonline.com","login.live.com","*.aadcdn.msftauth.net","*.aadcdn.msftauthimages.net","*.aadcdn.msauthimages.net","*.logincdn.msftauth.net","*.msauth.net","*.aadcdn.microsoftonline-p.com","*.microsoftonline-p.com","portal.azure.com","*.portal.azure.com","*.hosting.portal.azure.net","*.hosting-ms.portal.azure.net","*.reactblade.portal.azure.net","management.azure.com","*.ext.azure.com","*.graph.windows.net","*.graph.microsoft.com","hosting.partners.azure.net"]'
TF_VAR_azure_monitor_fqdns='["global.handler.control.monitor.azure.com","*.handler.control.monitor.azure.com","global.prod.microsoftmetrics.com","*.monitoring.azure.com","*.ods.opinsights.azure.com","*.oms.opinsights.azure.com","*.agentsvc.azure-automation.net","*.ingest.monitor.azure.com","*.monitor.azure.com"]'
TF_VAR_container_registry_fqdns='["mcr.microsoft.com","*.data.mcr.microsoft.com","ghcr.io","*.ghcr.io","pkg-containers.githubusercontent.com","*.docker.io","registry-1.docker.io","auth.docker.io","production.cloudflare.docker.com","production.cloudfront.docker.com","quay.io","*.quay.io","registry.k8s.io","k8s.gcr.io","gcr.io","*.gcr.io","*.pkg.dev","us-docker.pkg.dev","europe-docker.pkg.dev","asia-docker.pkg.dev","nvcr.io","*.nvcr.io","authn.nvidia.com","arcmktplaceprod.azurecr.io","*.data.azurecr.io","prod-registry-k8s-io-us-west-1.s3.dualstack.us-west-1.amazonaws.com","prod-registry-k8s-io-us-east-1.s3.dualstack.us-east-1.amazonaws.com","prod-registry-k8s-io-us-east-2.s3.dualstack.us-east-2.amazonaws.com","prod-registry-k8s-io-eu-west-1.s3.dualstack.eu-west-1.amazonaws.com","prod-registry-k8s-io-ap-northeast-1.s3.dualstack.ap-northeast-1.amazonaws.com","prod-registry-k8s-io-ap-southeast-1.s3.dualstack.ap-southeast-1.amazonaws.com"]'

# Optional: egress FQDNs the Linux jump host needs to install its toolchain
# (apt, installers, PyPI) when it runs behind the Azure Firewall. Matches
# scripts/bootstrap-jump-host.sh.
TF_VAR_tool_bootstrap_fqdns='["packages.microsoft.com","aka.ms","azurecliprod.blob.core.windows.net","azure.archive.ubuntu.com","security.ubuntu.com","apt.releases.hashicorp.com","dl.k8s.io","cdn.dl.k8s.io","get.helm.sh","astral.sh","releases.astral.sh","pypi.org","files.pythonhosted.org","github.com","api.github.com","*.githubusercontent.com","nvidia.github.io"]'

###############################################################################
# Anyscale control plane Private Link (optional, default-off)
###############################################################################
# When enabled, Terraform creates a cross-tenant private endpoint to the
# Anyscale Private Link Service, a private DNS zone, a VNet link, and A records
# so in-VNet workloads resolve the cloud-specific control plane hostname
# (cld-<cloud-resource-id>.<zone>) to a private IP instead of egressing through
# Azure Firewall. The connection is MANUAL: it stays Pending until Anyscale
# approves it, and a clean apply is not proof the path works.
#
# The PUBLIC browser/OAuth console host console.azure.anyscale.com is NOT part
# of the private zone and keeps resolving publicly. Do not expect it to resolve
# to the private endpoint IP.
#
# Set the alias, zone, and records only in the ignored repo-root .env; never
# commit the real alias. Terraform inputs must not come from a separate tfvars
# or -var-file source.
TF_VAR_enable_privatelink="false"
TF_VAR_anyscale_privatelink_service_alias=""
# Example: TF_VAR_anyscale_privatelink_service_alias="REPLACE-ME.00000000-0000-0000-0000-000000000000.westus2.azure.privatelinkservice"
TF_VAR_anyscale_private_dns_zone_name="azure.anyscale-cloud.dev"
TF_VAR_anyscale_privatelink_record_names='["*"]'

# When Private Link is enabled and the operator must reach the cloud-specific
# private host, set anyscale_platform.operator_control_plane_url to that host.
# The local Anyscale CLI/OAuth and teardown keep using the public console host
# (control_plane_url). Example (uncomment and set your cloud id, keep alias/id
# out of committed files):
# TF_VAR_anyscale_platform='{"operator_control_plane_url":"https://cld-00000000000000000000000000.azure.anyscale-cloud.dev"}'
TF_VAR_anyscale_platform='{}'
TF_VAR_anyscale_platform_arm_api_version="2026-08-01-preview"

###############################################################################
# AKS Image Integrity (Module 5 image-signing demo)
###############################################################################
# Create the Ratify + Azure Policy resources. Requires the deploying principal
# to hold Microsoft.Authorization/policyAssignments/write on the resource group.
# Set false for principals that cannot create policy assignments; the rest of
# the stack is unaffected. Default true preserves earlier behavior.
TF_VAR_enable_image_integrity="true"
# Notation signing certificate created in Key Vault for the image-integrity demo.
TF_VAR_image_signing_cert_name="notation-signing-cert-v2"
# Signing Key Vault retention posture.
TF_VAR_key_vault_purge_protection_enabled="false"
TF_VAR_key_vault_soft_delete_retention_days="7"

###############################################################################
# Platform RBAC and operator identity
###############################################################################
# Default gives the deploying principal platform admin at subscription scope.
TF_VAR_anyscale_platform_default_admin_assignment='{"enabled":true,"principal_type":"User","role_definition_name":"Anyscale Platform Administrator","scope":"subscription"}'

# Prefer this map for extra platform access.
TF_VAR_anyscale_platform_role_assignments='{}'
# Example:
# TF_VAR_anyscale_platform_role_assignments='{"data-science-team":{"principal_id":"00000000-0000-0000-0000-000000000000","principal_type":"Group","role_definition_name":"Anyscale Platform Contributor","scope":"cloud"}}'

#: Cloud-scoped role assignments; use the map above for subscription-scoped administrators.
TF_VAR_anyscale_platform_admin_role_assignments='{}'
TF_VAR_acr_push_principal_ids='{}'

# Optional extension pin for rollback testing.
# TF_VAR_anyscale_platform='{"extension_version":"1.5.1"}'

TF_VAR_anyscale_operator_namespace="anyscale-operator"
TF_VAR_anyscale_operator_serviceaccount="anyscale-operator"
# mode: create | existing-managed-rbac | existing-external-rbac
TF_VAR_anyscale_operator_identity='{"mode":"create"}'
# Jump-box bootstrap contract (namespaces, NVIDIA device plugin, gateway).
# '{}' takes the built-in defaults in infra/terraform/variables.tf.
TF_VAR_bootstrap_k8s='{}'
# Operator CLI token stored as an AKS extension protected setting. Leave empty to
# install the extension without the secret. Never commit a real token.
TF_VAR_anyscale_cli_token=""

###############################################################################
# AKS sizing
###############################################################################
TF_VAR_availability_zones='["1","2","3"]'
TF_VAR_aks_sku_tier="Standard"
# AKS upgrade channels and security posture.
TF_VAR_automatic_upgrade_channel="patch"
TF_VAR_node_os_upgrade_channel="SecurityPatch"
TF_VAR_azure_policy_enabled="true"
TF_VAR_defender_enabled="true"
TF_VAR_local_account_disabled="true"
TF_VAR_key_vault_secrets_provider_enabled="true"
# Use 'null' only when intentionally taking the regional default.
TF_VAR_kubernetes_version="1.34.6"
TF_VAR_system_node_pool_min_count="3"
TF_VAR_system_node_pool_max_count="6"
TF_VAR_system_vm_size="Standard_D2s_v5"
TF_VAR_cpu_vm_size="Standard_D16s_v5"
# Default keeps one T4 warm so the first GPU proof does not wait on scale-from-zero.
TF_VAR_gpu_pool_configs='{"T4":{"name":"gput4","vm_size":"Standard_NC16as_T4_v3","product_name":"NVIDIA-T4","gpu_count":"1","min_count":1,"max_count":2,"availability_zones":[]}}'

###############################################################################
# Storage and registry
###############################################################################
TF_VAR_storage_cors_rule='{"allowed_headers":["*"],"allowed_methods":["GET","POST","PUT","HEAD","DELETE"],"allowed_origins":["https://*.anyscale.com"],"expose_headers":["Accept-Ranges","Content-Range","Content-Length"],"max_age_in_seconds":0}'
TF_VAR_storage_replication_type="ZRS"
TF_VAR_acr_zone_redundancy_enabled="true"

###############################################################################
# Observability
###############################################################################
TF_VAR_log_analytics_retention_days="30"
TF_VAR_log_analytics_internet_ingestion_enabled="false"
TF_VAR_log_analytics_internet_query_enabled="true"
TF_VAR_ampls_enabled="true"
TF_VAR_ampls_ingestion_access_mode="PrivateOnly"
TF_VAR_ampls_query_access_mode="Open"
TF_VAR_container_insights_v2_enabled="true"
TF_VAR_container_insights_streams='["Microsoft-ContainerLogV2","Microsoft-KubeEvents","Microsoft-KubePodInventory"]'
TF_VAR_container_insights_data_collection_interval="1m"
TF_VAR_container_insights_namespace_filtering_mode="Off"
TF_VAR_container_insights_namespaces='[]'
TF_VAR_terraform_managed_diagnostic_settings_enabled="true"
# Storage diagnostics. The variable is nullable (null inherits
# terraform_managed_diagnostic_settings_enabled), but a bool cannot be expressed
# as null through TF_VAR_*, so set it explicitly here.
TF_VAR_storage_diagnostic_settings_enabled="true"
